---
interface Props {
  title: string;
  summary: string;
  date: string;
  readTime: string;
  tags: string[];
  slug: string;
}

const { title, summary, date, readTime, tags, slug }: Props = Astro.props;
---

<div class="glass-card card-link">
  <a href={`/reports/${slug}/`}>
    <h3 class="text-sm font-medium tracking-wide mb-2">{title}</h3>
    <p class="text-xs text-text-secondary leading-relaxed mb-2">{summary}</p>
    <div class="flex items-center gap-4 text-xs text-text-secondary">
      <span>{date}</span>
      <span>{readTime} read</span>
      <div class="flex gap-2">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>
  </a>
</div>