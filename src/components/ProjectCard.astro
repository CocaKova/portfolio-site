---
interface Props {
  title: string;
  description: string;
  tags: string[];
  github?: string;
}

const { title, description, tags, github }: Props = Astro.props;
---

<div class="glass-card">
  <h3 class="text-sm font-medium tracking-wide mb-2">{title}</h3>
  <p class="text-xs text-text-secondary leading-relaxed mb-3">{description}</p>
  <div class="flex items-center gap-2 flex-wrap mb-3">
    {tags.map((tag) => <span class="tag">{tag}</span>)}
  </div>
  {github && (
    <a href={github} class="text-xs text-text-secondary hover:text-teal" target="_blank" rel="noopener">
      GitHub →
    </a>
  )}
</div>