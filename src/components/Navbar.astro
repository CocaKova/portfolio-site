---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Reports', href: '/reports/' },
  { label: 'About', href: '/about/' },
];

const { current } = Astro.props;
const isActive = (href: string) => {
  if (href === '/') return current === '/';
  return current.startsWith(href) && href !== '/';
};
---

<nav class="glass-nav">
  <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="text-lg font-light tracking-[0.1em] text-teal hover:text-gold transition-colors">CocaKova</a>
    <div class="hidden sm:flex items-center gap-8">
      {navItems.map((item) => (
        <a href={item.href} class={`nav-link ${isActive(item.href) ? 'nav-link-active' : ''}`}>{item.label}</a>
      ))}
    </div>
    <!-- Mobile menu button -->
    <button class="sm:hidden text-text-secondary" onclick="document.getElementById('mobile-nav').classList.toggle('hidden')">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>
  <div id="mobile-nav" class="hidden sm:hidden border-t border-white/5 px-6 py-4">
    {navItems.map((item) => (
      <a href={item.href} class={`nav-link block py-2 ${isActive(item.href) ? 'nav-link-active' : ''}`}>{item.label}</a>
    ))}
  </div>
</nav>